// The MySQL driver's wire CODEC (data/sql/mysql.ky) - gated OFFLINE against hand-built
// packets matching the MySQL protocol (no MySQL server was available, so the connect/query
// flow is spec-followed but not live-proven; the CODEC + auth here ARE verified). Covers:
// packet framing (u24 LE len + seq), COM_QUERY, lenenc column-def + text-row decode incl
// NULL, ERR packet, Handshake salt extraction, and the native_password auth scramble against
// an independent (python hashlib) golden vector.
import assert;
import bytes;
import string;
import list;
import db;
import codec;
import typemap;
import auth;
import crypto.hash.sha;

// little-endian + lenenc builders (mirror the server encoding)
fn u16leb(v: int): string { let p = bytes.alloc(2); bytes.write_byte(p,0,v%256); bytes.write_byte(p,1,(v/256)%256); return p as string; }
fn u32leb(v: int): string { let p = bytes.alloc(4); bytes.write_byte(p,0,v%256); bytes.write_byte(p,1,(v/256)%256); bytes.write_byte(p,2,(v/65536)%256); bytes.write_byte(p,3,(v/16777216)%256); return p as string; }
fn b(v: int): string { let p = bytes.alloc(1); bytes.write_byte(p, 0, v); return p as string; }
fn lstr(s: string): string { return b(s.length) + s; }   // lenenc-str (short form)

@test
fn test_comquery_framing(): void {
    // [u24 len LE][seq][0x03][sql]. sql "Q" -> payload len 2; frame = 3+1+2.
    let f = codec.buildComQuery("Q");
    assert.equalInt(f.length, 6);
    assert.equalInt(f[0], 2);    // len low byte
    assert.equalInt(f[1], 0);
    assert.equalInt(f[2], 0);
    assert.equalInt(f[3], 0);    // sequence id 0
    assert.equalInt(f[4], 3);    // COM_QUERY
    assert.equalInt(f[5], 81);   // 'Q'
}

@test
fn test_column_def_decode(): void {
    // catalog,schema,table,org_table,name,org_name (lenenc-str) + lenenc(0x0c) + charset(u16)
    // + col_len(u32) + type(u8) ... type 3 = LONG -> Int4.
    let cd = lstr("def") + lstr("db") + lstr("t") + lstr("t") + lstr("id") + lstr("id")
        + b(12) + u16leb(63) + u32leb(11) + b(3);
    let col = codec.decodeColumnDef(cd);
    assert.equalStr(col.name, "id");
    assert.isTrue(col.type_oid == DbType.Int4);

    // type 253 = VAR_STRING -> Text.
    let cd2 = lstr("def") + lstr("db") + lstr("t") + lstr("t") + lstr("name") + lstr("name")
        + b(12) + u16leb(45) + u32leb(255) + b(253);
    assert.isTrue(codec.decodeColumnDef(cd2).type_oid == DbType.Text);
}

@test
fn test_text_row_decode(): void {
    let cols = List<Column>();
    cols.push(Column("id", DbType.Int4));
    cols.push(Column("name", DbType.Text));
    cols.push(Column("qty", DbType.Int4));

    // Row: id="10", name="widget", qty="42" (all lenenc-str, text protocol).
    let rp = lstr("10") + lstr("widget") + lstr("42");
    let row = codec.decodeTextRow(rp, cols);
    assert.equalInt(row.getInt(0), 10);
    assert.equalStr(row.getText(1), "widget");
    assert.equalInt(row.getInt(2), 42);

    // Row with NULL name: id="20", NULL (0xfb), qty="7".
    let rp2 = lstr("20") + b(251) + lstr("7");
    let row2 = codec.decodeTextRow(rp2, cols);
    assert.equalInt(row2.getInt(0), 20);
    assert.isTrue(row2.isNull(1));
    assert.equalInt(row2.getInt(2), 7);
}

@test
fn test_err_packet_decode(): void {
    // 0xff, error_code(u16), '#', sqlstate(5), message.
    let ep = b(255) + u16leb(1146) + b(35) + "42S02" + "Table missing";
    let err = codec.decodeErr(ep);
    assert.equalStr(err.code, "42S02");
    assert.equalStr(err.message, "Table missing");

    // T1: a decoded ERR packet now rides on the result (query/exec set rs.err / errorExec on 0xff).
    let rs = db.errorResult(err);
    assert.isTrue(rs.hasError());
    assert.equalStr(rs.err.code, "42S02");
    let xr = db.errorExec(err);
    assert.isTrue(xr.hasError());
    assert.isTrue(!db.ResultSet().hasError());
}

@test
fn test_handshake_salt_extraction(): void {
    // v10 handshake: proto(10), server-version cstr, conn-id(4), salt1(8), filler(0),
    // cap-low(2), charset(1), status(2), cap-high(2), auth-len(1)=21, reserved(10),
    // auth-plugin-data-part-2 = max(13, authLen-8) = 13 bytes (12 scramble + a trailing reserved NUL),
    // then the plugin cstr. Real MySQL always sends that 13th NUL byte (verified against MySQL 9.7).
    let hs = b(10) + "8.0.0" + b(0) + u32leb(7) + "AAAAAAAA" + b(0)
        + u16leb(0) + b(45) + u16leb(2) + u16leb(0)
        + b(21) + b(0)+b(0)+b(0)+b(0)+b(0)+b(0)+b(0)+b(0)+b(0)+b(0)
        + "BBBBBBBBBBBB" + b(0) + "mysql_native_password" + b(0);
    let h = codec.parseHandshake(hs);
    assert.equalStr(h.salt, "AAAAAAAABBBBBBBBBBBB");   // salt1 ++ salt2 = 20 bytes
    assert.equalStr(h.plugin, "mysql_native_password");
}

@test
fn test_native_password_scramble_golden(): void {
    // Independently verified with python hashlib:
    //   scramble('secret', bytes(1..20)) = b3 2b b3 a5 83 e1 34 0c 0a 11 08 d5 8b 1b e4 97 81 ad 8c 2f
    let sb = bytes.alloc(20);
    let i = 0;
    while (i < 20) { bytes.write_byte(sb, i, i + 1); i = i + 1; }
    let salt = sb as string;
    let out = auth.mysqlNativeScramble("secret", salt);
    assert.equalInt(out.length, 20);
    let gp = out as ptr;
    assert.equalInt(bytes.read_byte(gp, 0), 179);
    assert.equalInt(bytes.read_byte(gp, 1), 43);
    assert.equalInt(bytes.read_byte(gp, 2), 179);
    assert.equalInt(bytes.read_byte(gp, 19), 47);
}

@test
fn test_ssl_request_frame(): void {
    // T2: SSLRequest = [u24 len=32 LE][seq][32-byte trunc HandshakeResponse41 with CLIENT_SSL].
    let f = codec.buildSSLRequest(2048 + 8, 1);   // caps with CLIENT_SSL(0x800) set
    assert.equalInt(f.length, 36);   // 3 (len) + 1 (seq) + 32 (body)
    assert.equalInt(f[0], 32);       // payload length low byte
    assert.equalInt(f[1], 0); assert.equalInt(f[2], 0);
    assert.equalInt(f[3], 1);        // sequence id
    // caps u32le starts at byte 4; CLIENT_SSL (0x800) is bit 3 of byte 5.
    assert.equalInt(f[5] & 8, 8);
}

@test
fn test_text_datetime_decode(): void {
    // T3: a DATETIME column (text protocol) keeps its string instead of being parseI64'd to the year.
    let cols = List<Column>();
    cols.push(Column("ts", DbType.Timestamp));
    let rp = lstr("2024-01-01 10:00:00");
    let row = codec.decodeTextRow(rp, cols);
    assert.equalStr(row.getTimestamp(0), "2024-01-01 10:00:00");
}

@test
fn test_multidigit_param_and_blob(): void {
    // T4: multi-digit $N + binary-safe x'HEX' blob literal.
    let p = List<DbValue>();
    let i = 0;
    while (i < 12) { p.push(db.dbInt(i + 1)); i = i + 1; }
    assert.equalStr(typemap.substituteParams("VALUES ($1, $10, $12)", p), "VALUES (1, 10, 12)");
    let pb = List<DbValue>();
    pb.push(db.dbBlob("Hi"));
    assert.equalStr(typemap.substituteParams("$1", pb), "x'4869'");
}

@test
fn test_multipacket_reassembly(): void {
    // T14 Feature 1: a payload >= 0xFFFFFF is split - a packet whose length == 0xFFFFFF is a
    // continuation marker; the logical payload continues until a packet with len < 0xFFFFFF.
    // Build [0xFFFFFF-len packet][small packet] as ONE contiguous framed buffer and assert the
    // reassembled payload length == 0xFFFFFF + small (bodies are zero-filled; only the join matters).
    let big = 16777215;           // 0xFFFFFF
    let small = 5;
    let off2 = 4 + big;           // second packet header offset
    let total = 4 + big + 4 + small;
    let buf = bytes.alloc(total); // zero-filled bodies
    // first header: u24 len = 0xFFFFFF (255,255,255), seq 0
    bytes.write_byte(buf, 0, 255); bytes.write_byte(buf, 1, 255); bytes.write_byte(buf, 2, 255);
    bytes.write_byte(buf, 3, 0);
    // second header: u24 len = 5 (5,0,0), seq 1
    bytes.write_byte(buf, off2, small); bytes.write_byte(buf, off2 + 1, 0); bytes.write_byte(buf, off2 + 2, 0);
    bytes.write_byte(buf, off2 + 3, 1);
    let joined = codec.reassemblePayload(buf as string, 0);
    assert.equalInt(joined.length, big + small);

    // A single packet with len < 0xFFFFFF is returned as-is (no continuation).
    let sp = b(3) + b(0) + b(0) + b(7) + "abc";   // len 3, seq 7, body "abc"
    assert.equalStr(codec.reassemblePayload(sp, 0), "abc");

    // A continuation followed by a 0-length terminator packet stops the run at the empty packet.
    let big2 = 16777215;
    let t2 = 4 + big2 + 4;                          // [0xFFFFFF pkt][0-len pkt]
    let tbuf = bytes.alloc(t2);
    bytes.write_byte(tbuf, 0, 255); bytes.write_byte(tbuf, 1, 255); bytes.write_byte(tbuf, 2, 255);
    // trailing header is len 0 (already zeroed) at offset 4+big2
    let joined2 = codec.reassemblePayload(tbuf as string, 0);
    assert.equalInt(joined2.length, big2);
}

@test
fn test_caching_sha2_scramble_roundtrip(): void {
    // T14 Feature 2: caching_sha2_password fast-auth scramble.
    //   token = SHA256(pw) XOR SHA256( SHA256(SHA256(pw)) ++ nonce )
    // Structural + round-trip self-check (no published vector needed): the token is 32 bytes, and
    // token XOR SHA256(pw) must reproduce the inner hash SHA256(SHA256(SHA256(pw)) ++ nonce).
    let sb = bytes.alloc(20);
    let i = 0;
    while (i < 20) { bytes.write_byte(sb, i, i + 1); i = i + 1; }
    let nonce = sb as string;
    let pw = "secret";

    let token = auth.cachingSha2Scramble(pw, nonce);
    assert.equalInt(token.length, 32);

    // Recompute the inner hash independently via the crypto/hash/sha256 primitive.
    let inner = sha.sha256Raw(sha.sha256Raw(sha.sha256Raw(pw)) + nonce);
    let s1 = sha.sha256Raw(pw);
    let tp = token as ptr;
    let ip = inner as ptr;
    let sp2 = s1 as ptr;
    let k = 0;
    while (k < 32) {
        // token[k] XOR SHA256(pw)[k] == inner[k]
        assert.equalInt(bytes.read_byte(tp, k) ^ bytes.read_byte(sp2, k), bytes.read_byte(ip, k));
        k = k + 1;
    }

    // Consistency: cachingSha2Scramble is the same wire scramble as mysqlSha2Scramble.
    let alt = auth.mysqlSha2Scramble(pw, nonce);
    let ap = alt as ptr;
    let m = 0;
    while (m < 32) { assert.equalInt(bytes.read_byte(tp, m), bytes.read_byte(ap, m)); m = m + 1; }
}
